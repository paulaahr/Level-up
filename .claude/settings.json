{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "node \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.cjs\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "node \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/format-file.cjs\"; exit $LASTEXITCODE",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
