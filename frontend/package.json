{
  "name": "level-up-frontend",
  "version": "1.0.0",
  "description": "Frontend basico en React + TypeScript para el Departamento de Pawnee (sin framework de estilos)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/entorno-aislado.mjs test",
    "dev:aislado": "node scripts/entorno-aislado.mjs serve",
    "build:aislado": "tsc --noEmit --incremental false && node scripts/entorno-aislado.mjs build",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:real": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "26.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "3.2.7"
  }
}
